# =============================================================================
# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in the values.
# Do NOT commit terraform.tfvars (it contains secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# Proxmox Connection
# -----------------------------------------------------------------------------
# When running remotely:  use the full URL of your Proxmox host
# When running on the host itself: use https://127.0.0.1:8006
pm_tls_insecure     = true                             # set true for self-signed certs
pm_api_url          = "https://proxmox.example.com:8006"
pm_api_token_id     = "terraform@pve!mytoken"          # format: user@realm!tokenid
pm_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Proxmox Infrastructure
# -----------------------------------------------------------------------------
proxmox_node     = "pve"                  # Node name (e.g. pve, pve1, etc.)
storage_pool     = "local-lvm"            # Storage pool for VM disks
template_name    = "ubuntu-24.04-cloud"   # Cloud-Init template name
network_bridge   = "vmbr0"                # Bridge for VM network interfaces

# Cloud-Init defaults (used when creating VMs)
proxmox_ciuser     = "ubuntu"
proxmox_cipassword = "ChangeMe123!"       # Prefer SSH keys in production

# Starting VMID will randomize between 1000-5000 when = true(default), VMID will start at 200 when = false
randomize_vmid = "false"

# -----------------------------------------------------------------------------
# Network / IP Addresses
# -----------------------------------------------------------------------------
bastion_ip     = "10.10.10.10"
master_ips     = ["10.10.10.11", "10.10.10.12", "10.10.10.13"]
worker_ips     = ["10.10.10.14", "10.10.10.15", "10.10.10.16", "10.10.10.17"]
monitoring_ip  = "10.10.10.18"
dns_servers    = "8.8.8.8 8.8.4.4"         # space-separated list

# -----------------------------------------------------------------------------
# Vault / OpenBao (optional)
# -----------------------------------------------------------------------------
# If these are set, Terraform will try to read Proxmox credentials from Vault.
# If they are left empty / null, it falls back to the pm_api_* values above.

vault_address = ""                        # Vault Address 

vault_mount = "terraform"
vault_name = "proxmox"                                                                  

vault_role_id   = ""                      # AppRole Role ID
vault_secret_id = ""                      # AppRole Secret ID

vault_pm_api_url = "https://proxmox.example.com:8006"
vault_pm_api_token_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" 
vault_pm_api_token_secret = "terraform@pve!mytoken"

# -----------------------------------------------------------------------------
# Ansible Connection + SSH
# -----------------------------------------------------------------------------

# SSH user on the VMs
ansible_user = "ansible_user"
# Path to the public key that will be injected into the VMs via Cloud-Init
ssh_private_key_file = "/home/ansible_user/.ssh/terraform"